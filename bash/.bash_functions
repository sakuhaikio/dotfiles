vimf() {
    local file
    file=$($FIND --type f --hidden --exclude build --exclude .git "$@" | fzf) || return
    vim "$file"
}

cdf() {
    local dir
    dir=$($FIND --type d | fzf) || return
    cd "$dir"
}
